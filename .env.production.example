# Contoh .env PRODUKSI RelaxBoss (TASK-031). Salin ke .env di server, isi nilai kosong, jangan commit .env asli.
# Nilai rahasia (APP_KEY, DB_PASSWORD, MAIL_PASSWORD, GROQ_KEYS_*, ADMIN_SEED_PASSWORD) hanya di server.

APP_NAME=RelaxBoss
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI-DENGAN-DOMAIN-ASLI

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email harus benar-benar terkirim (bukan log atau array). Isi sesuai penyedia SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Admin awal untuk AdminSeeder. Sandi minimal 12 karakter; hapus baris sandi setelah admin dibuat.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# AI (Groq): satu pool per fitur, key dipisah koma. Jangan pernah dicatat atau di-commit.
GROQ_KEYS_CHAT=
GROQ_KEYS_ASSESSMENT=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800

# Cadangan database (relaxboss:backup-db). Ubah hanya bila mysqldump tidak ada di PATH hosting
# atau tidak mengenal opsi tambahan (kosongkan BACKUP_MYSQLDUMP_EXTRA bila galat "unknown option").
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQLDUMP_EXTRA=--no-tablespaces
