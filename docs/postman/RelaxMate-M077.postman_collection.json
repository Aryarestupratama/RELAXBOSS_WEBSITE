                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const d = j.data;",
                  "pm.test(\"hari ini kini mood 1 (terakhir menang), masih 3 hari\", () => { pm.expect(d.days.length).to.eql(3); pm.expect(d.days[2].mood).to.eql(1); });",
                  "pm.test(\"rata-rata (5+3+1)/3 = 3\", () => pm.expect(d.summary.average).to.eql(3));"
                ]
