    {
      "name": "03 Isolasi",
      "item": [
        {
          "name": "03.1 Isolasi: B hanya melihat datanya sendiri",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const d = j.data;",
                  "pm.test(\"1 hari, mood 5\", () => { pm.expect(d.days.length).to.eql(1); pm.expect(d.days[0].mood).to.eql(5); });",
