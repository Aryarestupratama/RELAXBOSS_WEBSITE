              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-entries/abc"
            }
          }
        },
        {
          "name": "03.6 Tanpa token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-entries/{{entryId}}"
            }
          }
        },
        {
          "name": "03.7 Setelah hapus, entri tidak ada lagi di buku harian",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"entri terhapus tidak ada\", () => pm.expect(pm.response.json().data.entries.map(e => e.id)).to.not.include(Number(pm.collectionVariables.get(\"entryId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal?before=999999999"
            }
          }
        }
      ]
    }
  ]
}