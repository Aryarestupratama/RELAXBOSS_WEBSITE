{
  "info": {
    "name": "RelaxMate Mobile API - TASK-M078 (buku harian: GET /mood-journal, PATCH dan DELETE /mood-entries/{id})",
    "description": "Uji manual API-M020 sampai M022. Jalankan docs/postman/m078-seed.php di tinker dulu, salin tokenA, tokenB, tokenC ke Variables. Ikuti docs/API-Test-Guide.md bagian H di repo mobile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "tokenC",
      "value": ""
    },
    {
      "key": "nextBefore",
      "value": ""
    },
    {
      "key": "entryId",
      "value": ""
    },
    {
      "key": "longNote",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Akses",
      "item": [
        {
          "name": "00.1 Tanpa token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal"
            }
          }
        },
        {
          "name": "00.2 Belum terverifikasi (C) -> 403 unverified",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"kode unverified\", () => pm.expect(pm.response.json().error.code).to.eql(\"unverified\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenC}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal"
            }
          }
        }
      ]
    },
    {
      "name": "01 Baca buku harian (API-M020)",
      "item": [
        {
          "name": "01.1 Halaman pertama (A): 10 entri, ada next_before",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"10 entri\", () => pm.expect(d.entries.length).to.eql(10));",
                  "pm.test(\"semua punya catatan\", () => d.entries.forEach(e => pm.expect(e.note).to.be.a(\"string\").and.not.empty));",
                  "pm.test(\"urut id menurun\", () => { for (let i = 1; i < d.entries.length; i++) pm.expect(d.entries[i-1].id).to.be.above(d.entries[i].id); });",
                  "pm.test(\"tidak ada entri B\", () => pm.expect(JSON.stringify(d)).to.not.include(\"RAHASIA-M078-B\"));",
                  "pm.test(\"bentuk entri\", () => { const e = d.entries[0]; [\"id\",\"mood\",\"mood_label\",\"arousal_input\",\"arousal_label\",\"note\",\"entry_date\",\"logged_at\",\"edited\"].forEach(k => pm.expect(e).to.have.property(k)); pm.expect(e.edited).to.eql(false); });",
                  "pm.test(\"next_before = id terakhir\", () => pm.expect(d.next_before).to.eql(d.entries[9].id));",
                  "pm.collectionVariables.set(\"nextBefore\", d.next_before);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal"
            }
          }
        },
        {
          "name": "01.2 Halaman kedua: 3 entri, next_before null",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"3 entri\", () => pm.expect(d.entries.length).to.eql(3));",
                  "pm.test(\"next_before null\", () => pm.expect(d.next_before).to.eql(null));",
                  "pm.test(\"semua id lebih kecil dari kursor\", () => d.entries.forEach(e => pm.expect(e.id).to.be.below(Number(pm.collectionVariables.get(\"nextBefore\")))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal?before={{nextBefore}}"
            }
          }
        },
        {
          "name": "01.3 before tidak valid -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"validation_failed\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_failed\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal?before=abc"
            }
          }
        },
        {
          "name": "01.4 Pengguna B hanya melihat miliknya",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"1 entri\", () => pm.expect(d.entries.length).to.eql(1));",
                  "pm.test(\"bukan data A\", () => pm.expect(JSON.stringify(d)).to.not.include(\"RAHASIA-M078-A\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-journal"
            }
          }
        }
      ]
